# Local Go API origin used by browser-side catalog, intake, tracking, quote, and payment calls.
# Do not include /api/v1. Cloudflare Pages must override this with the environment's HTTPS API origin.
NEXT_PUBLIC_FIXXIR_API_URL=http://localhost:8080

# Comma-separated tunnel hostnames allowed to access Next.js dev endpoints.
# Hostnames or full HTTP(S) URLs are accepted; Next.js receives only hostnames.
NEXT_DEV_ALLOWED_ORIGINS=
